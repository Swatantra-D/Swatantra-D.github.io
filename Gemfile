source "https://rubygems.org"

# Same gem versions GitHub Pages uses for its built-in Jekyll build.
gem "github-pages", group: :jekyll_plugins

# Needed by `jekyll serve` on Ruby 3+.
gem "webrick", "~> 1.8"

# Silences a warning from jekyll-github-metadata during local builds.
gem "faraday-retry"

# Windows does not ship zoneinfo files; harmless elsewhere.
gem "tzinfo-data", platforms: [:windows, :jruby]
